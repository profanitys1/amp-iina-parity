+// Port of mac/common.swift currentFps() (and of cocoa_common.m
+// vo_cocoa_update_screen_fps() before it): the measured period when it is
+// within 0.1 Hz of the nominal one, else the nominal one, else 60 Hz.
+// The timeValue > 0 check is an addition; upstream divides unguarded.
+// *out_nominal receives the nominal rate, or 0 when it is unknown.
+static double current_fps(struct ra_ctx *ctx, double *out_nominal)
+{
+    struct priv *p = ctx->priv;
+    *out_nominal = 0;
+    double actual_fps = CVDisplayLinkGetActualOutputVideoRefreshPeriod(p->link);
+    CVTime nominal = CVDisplayLinkGetNominalOutputVideoRefreshPeriod(p->link);
+
+    if (!(nominal.flags & kCVTimeIsIndefinite) && nominal.timeValue > 0) {
+        double nominal_fps = nominal.timeScale / (double)nominal.timeValue;
+        *out_nominal = nominal_fps;
+
+        if (actual_fps > 0)
+            actual_fps = 1 / actual_fps;
+
+        if (fabs(actual_fps - nominal_fps) > 0.1) {
+            MP_VERBOSE(ctx, "Falling back to nominal display refresh rate: %f\n",
+                       nominal_fps);
+            return nominal_fps;
+        }
+        return actual_fps;
+    }
+
+    MP_WARN(ctx, "Falling back to standard display refresh rate: 60Hz\n");
+    return 60.0;
 }
 
