+// VO thread only: ra_vk_ctx_resize() writes vo->dwidth/dheight, which vo.h
+// reserves for the VO thread.
+static void apply_size(struct ra_ctx *ctx, int w, int h)
+{
+    struct priv *p = ctx->priv;
+    if (!ra_vk_ctx_resize(ctx, w, h))
+        MP_WARN(ctx, "Could not resize the swapchain to %dx%d\n", w, h);
+    MP_VERBOSE(ctx, "Layer %dx%d, swapchain %dx%d\n", w, h,
+               ctx->vo->dwidth, ctx->vo->dheight);
+
+    // Record the request, not the result, so a size the swapchain cannot take
+    // does not make the display link wake the VO on every vsync.
+    mp_mutex_lock(&p->lock);
+    p->applied_w = w;
+    p->applied_h = h;
+    p->configured = true;
+    mp_mutex_unlock(&p->lock);
+}
