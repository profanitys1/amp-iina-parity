-        bind_display(ctx);
+    struct priv *p = ctx->priv;
+
+    switch (request) {
+    case VOCTRL_CHECK_EVENTS: {
+        // vo.c sends this once per VO loop iteration, on the VO thread.
+        mp_mutex_lock(&p->lock);
+        *events |= p->pending_events;
+        p->pending_events = 0;
+        p->wake_pending = false;
+        bool configured = p->configured;
+        int applied_w = p->applied_w, applied_h = p->applied_h;
+        mp_mutex_unlock(&p->lock);
+
+        if (configured) {
+            CGSize s = p->layer.drawableSize;
+            int w = to_px(s.width), h = to_px(s.height);
+            // > 1, not > 0: 1x1 is MoltenVK's placeholder, not a layout size.
+            if (w > 1 && h > 1 && (w != applied_w || h != applied_h)) {
+                apply_size(ctx, w, h);
+                // vo_gpu_next control(): RESIZE -> resize(vo) recomputes the
+                // src/dst rects from vo->dwidth/dheight and sets want_redraw.
+                // Same pair as upstream mac_common.swift windowDidResize().
+                *events |= VO_EVENT_RESIZE | VO_EVENT_EXPOSE;
+            }
+        }
+        return VO_TRUE;
+    }
+    case VOCTRL_VO_OPTS_CHANGED:
+        // Sent on the VO thread whenever a vo option such as --screen-name
+        // changes, so the display link follows the window. WIN_STATE makes
+        // vo.c update_display_fps() ask VOCTRL_GET_DISPLAY_FPS again.
+        if (bind_display(ctx))
+            *events |= VO_EVENT_WIN_STATE;
+        return VO_TRUE;
+    case VOCTRL_GET_DISPLAY_FPS: {
+        // Without a display link there is nothing bound to measure; leave
+        // display_fps at 0 (vo.c initialises fps to 0 and ignores the return).
+        if (!p->link)
+            return VO_NOTIMPL;
+        double nominal_fps;
+        *(double *)arg = current_fps(ctx, &nominal_fps);
+        mp_mutex_lock(&p->lock);
+        p->nominal_fps = nominal_fps;
+        p->fps_flag_after = mp_time_ns() + FPS_FLAG_INTERVAL_NS;
+        mp_mutex_unlock(&p->lock);
+        return VO_TRUE;
+    }
+    }
     return VO_NOTIMPL;
 }
 
