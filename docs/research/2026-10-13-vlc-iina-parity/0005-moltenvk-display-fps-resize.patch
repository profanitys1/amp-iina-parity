     CGSize s = p->layer.drawableSize;
-    ra_vk_ctx_resize(ctx, s.width, s.height);
+    int w = to_px(s.width), h = to_px(s.height);
+    if (w <= 1 || h <= 1) {
+        // MoltenVK parks drawableSize at 1x1 between swapchains
+        // (MVKSwapchain::forceUnpresentedImageCompletion). Use the extent
+        // MoltenVK reports as currentExtent instead: bounds * contentsScale.
+        CGSize b = p->layer.bounds.size;
+        CGFloat scale = p->layer.contentsScale;
+        w = to_px(b.width * scale);
+        h = to_px(b.height * scale);
+    }
+    apply_size(ctx, w, h);
     return true;
 }
 
 static int moltenvk_control(struct ra_ctx *ctx, int *events, int request, void *arg)
 {
-    // vo.c sends this on the VO thread whenever a vo option such as
-    // --screen-name changes, so the display link follows the window.
